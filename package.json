{
  "name": "@terminalzero/lemonsqueezy",
  "description": "Experimental community-maintained Lemon Squeezy SDK for JavaScript and TypeScript, maintained by Terminal Zero. Not affiliated with or endorsed by Lemon Squeezy.",
  "version": "5.0.0-beta.0",
  "author": {
    "name": "Terminal Zero",
    "url": "https://github.com/terminalzero-dev"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat/index.d.ts",
        "default": "./dist/compat/index.js"
      },
      "require": {
        "types": "./dist/compat/index.d.cts",
        "default": "./dist/compat/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts"
      },
      "require": {
        "types": "./dist/types/index.d.cts"
      }
    }
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/terminalzero-dev/lemonsqueezy.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/terminalzero-dev/lemonsqueezy.js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/terminalzero-dev/lemonsqueezy.js/issues"
  },
  "keywords": [
    "api",
    "sdk",
    "lemonsqueezy",
    "javascript",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/normalize-build.mjs && node scripts/validate-build.mjs",
    "build:reproducible": "node scripts/verify-reproducible-build.mjs",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:repository && pnpm build:reproducible && pnpm test:build && pnpm pack:artifact && pnpm test:artifact && pnpm test:types && pnpm test:package",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "pack:artifact": "node scripts/pack-artifact.mjs",
    "test": "vitest run",
    "test:artifact": "node --test test/toolchain/canonical-artifact.test.mjs",
    "test:build": "node --test test/toolchain/build-output.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:repository": "node --test test/toolchain/repository-toolchain.test.mjs",
    "test:types": "node scripts/test-types.mjs",
    "tool:versions": "node scripts/tool-versions.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "version": "changeset version && pnpm install --lockfile-only && pnpm install --frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.0",
    "oxfmt": "~0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "~7.0.2001",
    "rollup": "^4.0.0",
    "tsdown": "~0.22.14",
    "typescript": "~6.0.3",
    "typescript-5-4": "npm:typescript@5.4.5",
    "typescript-latest": "npm:typescript@7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "webpack": "^5.0.0"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "bun": ">=1.3.14 <2"
  },
  "packageManager": "pnpm@11.21.0"
}
